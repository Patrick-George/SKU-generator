<%- include('partials/head') %>
<h1 class="page-title">Category - Item Pairs</h1>
<p class="page-sub">Reference table of product categories and their item groups</p>
<form method="get" action="/category-items">
  <input name="q" value="<%= q %>" placeholder="Filter by category or item">
</form>
<% if (!groups.length) { %>
  <div class="banner info">No matching pairs.</div>
<% } %>
<% groups.forEach(([cat, items]) => { %>
  <details class="history" open>
    <summary><strong><%= cat %></strong> <span class="muted">(<%= items.length %>)</span></summary>
    <ul>
      <% items.forEach((item) => { %><li><%= item %></li><% }) %>
    </ul>
  </details>
<% }) %>
<%- include('partials/foot') %>
